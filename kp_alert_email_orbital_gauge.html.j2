{#
  Design option: "Orbital Gauge"
  Modelled on the radial Kp-meter widgets used on real space-weather
  operations dashboards. The hero is a semicircular gauge instead of a
  typographic display.
  Same context contract as kp_alert_email.html.j2. See that file's header
  for the full field list.
#}
{% set severity_color = {'G1': '#e8c547', 'G2': '#f0a83c', 'G3': '#f0793c', 'G4': '#ef4b4b', 'G5': '#d61f5c'} %}
{% set accent = severity_color[level_code] %}
{% set needle_point = {
  'G1': (167.4, 51.5), 'G2': (200.0, 63.4), 'G3': (226.6, 85.7),
  'G4': (244.0, 115.8), 'G5': (250.0, 150.0),
} %}
{% set tip = needle_point[level_code] %}
{% set activity_rows = [
  {'code':'QUIET','label':'Quiet','kp':'0–3','effect':'Quiet conditions'},
  {'code':'ACTIVE','label':'Active','kp':'4','effect':'Moderate geomagnetic activity'},
  {'code':'G1','label':'Minor Storm (G1)','kp':'5','effect':'Weak power grid fluctuations'},
  {'code':'G2','label':'Moderate Storm (G2)','kp':'6','effect':'High-latitude power systems affected'},
  {'code':'G3','label':'Strong Storm (G3)','kp':'7','effect':'Power systems may need voltage corrections'},
  {'code':'G4','label':'Severe Storm (G4)','kp':'8','effect':'Possible widespread voltage control problems'},
  {'code':'G5','label':'Extreme Storm (G5)','kp':'9','effect':'Widespread power system voltage control problems'},
] %}
{% set caption = forecast_caption if forecast_caption is defined and forecast_caption else "Colours indicate geomagnetic activity levels: green for quiet (Kp < 3), yellow for moderate (3 < Kp <= 6), red for storm (Kp > 6). The dashed line is the official NOAA SWPC Kp forecast; error bars show the ensemble min-max spread." %}
{% set sans = "Inter, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#eef1f5;">
<span style="display:none;font-size:1px;color:#ffffff;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">{{ subject }}</span>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#eef1f5;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#ffffff;">

<tr><td style="padding:22px 30px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
    <td style="font-family:{{ sans }};font-size:12px;color:#5b6472;">GFZ Space Weather Ops</td>
    <td align="right" style="font-family:{{ sans }};font-size:12px;color:#5b6472;">{{ issued }}</td>
  </tr></table>
</td></tr>

<tr><td style="padding:6px 30px 0;" align="center">
  <svg viewBox="0 0 300 165" width="300" height="165" style="display:block;margin:0 auto;" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Kp gauge showing {{ level_code }}">
    <path d="M30,150 A120,120 0 0 1 58.1,72.9" fill="none" stroke="#2ecc8f" stroke-width="14" stroke-linecap="round"/>
    <path d="M58.1,72.9 A120,120 0 0 1 129.2,31.8" fill="none" stroke="#8fd13f" stroke-width="14" stroke-linecap="round"/>
    <path d="M129.2,31.8 A120,120 0 0 1 170.8,31.8" fill="none" stroke="#e8c547" stroke-width="14"/>
    <path d="M170.8,31.8 A120,120 0 0 1 210.0,46.1" fill="none" stroke="#f0a83c" stroke-width="14"/>
    <path d="M210.0,46.1 A120,120 0 0 1 241.9,72.9" fill="none" stroke="#f0793c" stroke-width="14"/>
    <path d="M241.9,72.9 A120,120 0 0 1 262.8,109.0" fill="none" stroke="#ef4b4b" stroke-width="14"/>
    <path d="M262.8,109.0 A120,120 0 0 1 270.0,150.0" fill="none" stroke="#d61f5c" stroke-width="14" stroke-linecap="round"/>
    <line x1="150" y1="150" x2="{{ tip[0] }}" y2="{{ tip[1] }}" stroke="#1c2430" stroke-width="4" stroke-linecap="round"/>
    <circle cx="150" cy="150" r="8" fill="#1c2430"/>
    <text x="150" y="145" text-anchor="middle" font-family="{{ sans }}" font-size="34" font-weight="700" fill="{{ accent }}">{{ level_code }}</text>
    <text x="30" y="163" font-family="{{ sans }}" font-size="10" fill="#8b93a0">Kp 0</text>
    <text x="255" y="163" font-family="{{ sans }}" font-size="10" fill="#8b93a0" text-anchor="end">Kp 9</text>
  </svg>
  <div style="font-family:{{ sans }};font-size:13px;font-weight:600;letter-spacing:0.02em;color:{{ accent }};margin-top:-6px;">{{ level_name }}</div>
</td></tr>

<tr><td style="padding:16px 30px 0;font-family:{{ sans }};font-size:19px;font-weight:600;color:#1c2430;line-height:1.4;text-align:center;">
  {{ headline }}
</td></tr>
<tr><td style="padding:10px 30px 0;font-family:{{ sans }};font-size:14px;color:#454e5a;line-height:1.6;text-align:center;">
  {{ lede }}
</td></tr>

<tr><td style="padding:20px 30px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-top:1px solid #e3e7ec;border-bottom:1px solid #e3e7ec;">
    <tr>
      <td width="50%" style="padding:10px 0;font-family:{{ sans }};font-size:11px;color:#8b93a0;">CURRENT CONDITIONS<br><span style="font-size:14px;color:#1c2430;font-weight:600;">{{ current_conditions }}</span></td>
      <td width="50%" style="padding:10px 0;font-family:{{ sans }};font-size:11px;color:#8b93a0;">ALERT SENT<br><span style="font-size:14px;color:#1c2430;font-weight:600;">{{ issued }}</span></td>
    </tr>
  </table>
</td></tr>

<tr><td style="padding:20px 30px 0;">
  <img src="cid:forecast_image" width="540" alt="Kp forecast ensemble chart" style="width:100%;max-width:540px;height:auto;display:block;border-radius:8px;border:1px solid #e3e7ec;">
</td></tr>
<tr><td style="padding:8px 30px 0;font-family:{{ sans }};font-size:12px;color:#8b93a0;line-height:1.5;">
  {{ caption }}
</td></tr>

<tr><td style="padding:26px 30px 0;">
  <div style="font-family:{{ sans }};font-size:14px;font-weight:600;color:#1c2430;">Storm probability &middot; Kp &ge; 6</div>
{% if storm_rows %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ sans }};font-size:13px;margin:10px 0 0;">
  <tr>
    <td style="padding:6px 8px 6px 0;border-bottom:1px solid #e3e7ec;font-size:11px;color:#8b93a0;">Time (UTC)</td>
    <td style="padding:6px 8px 6px 0;border-bottom:1px solid #e3e7ec;font-size:11px;color:#8b93a0;">Kp 6&ndash;7</td>
    <td style="padding:6px 8px 6px 0;border-bottom:1px solid #e3e7ec;font-size:11px;color:#8b93a0;">Kp 7&ndash;8</td>
    <td style="padding:6px 0;border-bottom:1px solid #e3e7ec;font-size:11px;color:#8b93a0;">Kp &ge; 8</td>
  </tr>
  {% for row in storm_rows %}
    <tr>
      <td style="padding:8px 8px 8px 0;border-bottom:1px solid #f0f2f5;color:#1c2430;">{{ row.time }}</td>
      <td style="padding:8px 8px 8px 0;border-bottom:1px solid #f0f2f5;color:#1c2430;">{{ row.p67 }}</td>
      <td style="padding:8px 8px 8px 0;border-bottom:1px solid #f0f2f5;color:#1c2430;">{{ row.p78 }}</td>
      <td style="padding:8px 0;border-bottom:1px solid #f0f2f5;color:#1c2430;">{{ row.p8 }}</td>
    </tr>
  {% endfor %}
  </table>
  <div style="font-family:{{ sans }};font-size:11px;color:#8b93a0;padding-top:6px;">Showing timestamps where combined probability of Kp &ge; 6 exceeds 50%.</div>
{% else %}
  <div style="font-family:{{ sans }};font-size:12px;color:#8b93a0;margin:10px 0 0;">No individual storm-tier probability exceeds 50% at this time.</div>
{% endif %}
</td></tr>

<tr><td style="padding:26px 30px 0;">
  <div style="font-family:{{ sans }};font-size:14px;font-weight:600;color:#1c2430;">Geomagnetic activity scale</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ sans }};font-size:13px;margin:10px 0 0;">
    {% for row in activity_rows %}
    {% set active = row.code == activity_current_code %}
    <tr>
      <td width="10" style="padding:7px 0;"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:{{ severity_color.get(row.code, '#2ecc8f') }};"></span></td>
      <td style="padding:7px 8px;border-bottom:1px solid #f0f2f5;{{ 'font-weight:700;color:#1c2430;' if active else 'color:#454e5a;' }}">{{ row.label }}</td>
      <td style="padding:7px 8px;border-bottom:1px solid #f0f2f5;{{ 'font-weight:700;color:#1c2430;' if active else 'color:#454e5a;' }}">Kp {{ row.kp }}</td>
      <td style="padding:7px 0;border-bottom:1px solid #f0f2f5;color:#8b93a0;">{{ row.effect }}</td>
    </tr>
    {% endfor %}
  </table>
</td></tr>

{% if aurora.show %}
<tr><td style="padding:26px 30px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#f6f7f9;border-radius:10px;">
    <tr><td style="padding:14px 18px 6px;font-family:{{ sans }};font-size:14px;font-weight:600;color:#1c2430;">Aurora watch</td></tr>
    <tr><td style="padding:6px 18px 0;">
      <img src="cid:aurora_vid" width="504" alt="Kp-dependent auroral intensity prediction" style="width:100%;max-width:504px;height:auto;display:block;border-radius:6px;">
    </td></tr>
    <tr><td style="padding:10px 18px 16px;font-family:{{ sans }};font-size:13px;color:#454e5a;line-height:1.5;">{{ aurora.note }}</td></tr>
  </table>
</td></tr>
{% endif %}

<tr><td style="padding:30px 30px 26px;">
  <div style="border-top:1px solid #e3e7ec;padding-top:12px;font-family:{{ sans }};font-size:11px;color:#8b93a0;line-height:1.6;">
    This is an automated alert from the Kp Index Monitoring System using the GFZ Space Weather Forecast.<br><br>
    &copy; {{ year }} GFZ Helmholtz Centre for Geosciences | GFZ Helmholtz-Zentrum f&uuml;r Geoforschung.
    The data/data products are provided "as-is" without warranty of any kind, either expressed or implied, including but not limited to the implied warranties of merchantability, correctness and fitness for a particular purpose. GFZ is not liable for any direct, indirect, incidental or consequential damages arising from the use of this data.
  </div>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
