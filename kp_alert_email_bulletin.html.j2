{#
  Design option: "Field Bulletin"
  An official geophysical-institute notice — printed-bulletin restraint,
  a single grotesk sans throughout, severity read through rule weight and
  a bordered stamp rather than color fills.
  Same context contract as kp_alert_email.html.j2. See that file's header
  for the full field list.
#}
{% set severity_color = {
  'G1': '#4f7ea8', 'G2': '#b98a2e', 'G3': '#c1602b', 'G4': '#a63232', 'G5': '#6b1530',
} %}
{% set stamp_color = severity_color[level_code] %}
{% set activity_rows = [
  {'code':'QUIET','label':'Quiet','kp':'0–3','effect':'Quiet conditions'},
  {'code':'ACTIVE','label':'Active','kp':'4','effect':'Moderate geomagnetic activity'},
  {'code':'G1','label':'Minor Storm (G1)','kp':'5','effect':'Weak power grid fluctuations'},
  {'code':'G2','label':'Moderate Storm (G2)','kp':'6','effect':'High-latitude power systems affected'},
  {'code':'G3','label':'Strong Storm (G3)','kp':'7','effect':'Power systems may need voltage corrections'},
  {'code':'G4','label':'Severe Storm (G4)','kp':'8','effect':'Possible widespread voltage control problems'},
  {'code':'G5','label':'Extreme Storm (G5)','kp':'9','effect':'Widespread power system voltage control problems'},
] %}
{% set caption = forecast_caption if forecast_caption is defined and forecast_caption else "Colours indicate geomagnetic activity levels: green for quiet (Kp < 3), yellow for moderate (3 < Kp <= 6), red for storm (Kp > 6). The dashed line is the official NOAA SWPC Kp forecast; error bars show the ensemble min-max spread." %}
{% set sans = "'Helvetica Neue', Helvetica, Arial, 'Segoe UI', sans-serif" %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#dde1e4;">
<span style="display:none;font-size:1px;color:#eef0f2;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">{{ subject }}</span>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#eef0f2;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#eef0f2;">

<tr><td style="padding:0 30px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-bottom:3px solid #1b2733;"><tr>
    <td style="padding-bottom:10px;font-family:{{ sans }};font-size:13px;font-weight:700;color:#1b2733;">GFZ Helmholtz Centre for Geosciences</td>
    <td align="right" style="padding-bottom:10px;font-family:{{ sans }};font-size:11px;color:#5b6773;">Issued {{ issued }}</td>
  </tr></table>
</td></tr>

<tr><td style="padding:20px 30px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
    <td style="font-family:{{ sans }};font-size:22px;font-weight:700;color:#1b2733;line-height:1.3;">{{ headline }}</td>
    <td width="92" valign="top" align="center" style="border:2px solid {{ stamp_color }};padding:8px 4px;">
      <div style="font-family:{{ sans }};font-size:20px;font-weight:800;color:{{ stamp_color }};line-height:1;">{{ level_code }}</div>
      <div style="font-family:{{ sans }};font-size:9px;letter-spacing:0.04em;color:{{ stamp_color }};padding-top:4px;">{{ level_name }}</div>
    </td>
  </tr></table>
</td></tr>

<tr><td style="padding:14px 30px 0;font-family:{{ sans }};font-size:14px;color:#374350;line-height:1.6;">
  {{ lede }}
</td></tr>

<tr><td style="padding:18px 30px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border:1px solid #c7cdd3;">
    <tr>
      <td width="50%" style="padding:9px 12px;border-right:1px solid #c7cdd3;font-family:{{ sans }};font-size:10px;letter-spacing:0.04em;color:#5b6773;">CURRENT CONDITIONS<br><span style="font-size:13px;color:#1b2733;">{{ current_conditions }}</span></td>
      <td width="50%" style="padding:9px 12px;font-family:{{ sans }};font-size:10px;letter-spacing:0.04em;color:#5b6773;">ALERT SENT<br><span style="font-size:13px;color:#1b2733;">{{ issued }}</span></td>
    </tr>
  </table>
</td></tr>

<tr><td style="padding:20px 30px 0;background-color:#eef0f2;background-image:linear-gradient(#dfe3e6 1px, transparent 1px),linear-gradient(90deg, #dfe3e6 1px, transparent 1px);background-size:16px 16px;">
  <img src="cid:forecast_image" width="540" alt="Kp forecast ensemble chart" style="width:100%;max-width:540px;height:auto;display:block;border:1px solid #1b2733;">
</td></tr>
<tr><td style="padding:8px 30px 0;font-family:{{ sans }};font-size:11px;color:#5b6773;line-height:1.5;">
  {{ caption }}
</td></tr>

<tr><td style="padding:26px 30px 0;">
  <div style="font-family:{{ sans }};font-size:12px;font-weight:700;letter-spacing:0.03em;color:#1b2733;border-bottom:1px solid #1b2733;padding-bottom:6px;">Storm probability forecast (Kp &ge; 6)</div>
{% if storm_rows %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ sans }};font-size:13px;margin:6px 0 0;">
  <tr>
    <td style="padding:6px 8px 6px 0;border-bottom:1px solid #c7cdd3;font-size:10px;color:#5b6773;">Time (UTC)</td>
    <td style="padding:6px 8px 6px 0;border-bottom:1px solid #c7cdd3;font-size:10px;color:#5b6773;">Kp 6&ndash;7</td>
    <td style="padding:6px 8px 6px 0;border-bottom:1px solid #c7cdd3;font-size:10px;color:#5b6773;">Kp 7&ndash;8</td>
    <td style="padding:6px 0;border-bottom:1px solid #c7cdd3;font-size:10px;color:#5b6773;">Kp &ge; 8</td>
  </tr>
  {% for row in storm_rows %}
    <tr>
      <td style="padding:6px 8px 6px 0;border-bottom:1px solid #dde1e4;color:#1b2733;">{{ row.time }}</td>
      <td style="padding:6px 8px 6px 0;border-bottom:1px solid #dde1e4;color:#1b2733;">{{ row.p67 }}</td>
      <td style="padding:6px 8px 6px 0;border-bottom:1px solid #dde1e4;color:#1b2733;">{{ row.p78 }}</td>
      <td style="padding:6px 0;border-bottom:1px solid #dde1e4;color:#1b2733;">{{ row.p8 }}</td>
    </tr>
  {% endfor %}
  </table>
  <div style="font-family:{{ sans }};font-style:italic;font-size:11px;color:#5b6773;padding-top:6px;">Showing timestamps where combined probability of Kp &ge; 6 exceeds 50%.</div>
{% else %}
  <div style="font-family:{{ sans }};font-style:italic;font-size:12px;color:#5b6773;padding:8px 0 0;">No individual storm-tier probability exceeds 50% at this time.</div>
{% endif %}
</td></tr>

<tr><td style="padding:26px 30px 0;">
  <div style="font-family:{{ sans }};font-size:12px;font-weight:700;letter-spacing:0.03em;color:#1b2733;border-bottom:1px solid #1b2733;padding-bottom:6px;">Geomagnetic activity scale</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ sans }};font-size:13px;margin:6px 0 0;">
    {% for row in activity_rows %}
    {% set active = row.code == activity_current_code %}
    <tr>
      <td width="4" style="background:{{ '#1b2733' if active else 'transparent' }};"></td>
      <td style="padding:7px 8px 7px 10px;border-bottom:1px solid #dde1e4;{{ 'font-weight:700;color:#1b2733;' if active else 'color:#374350;' }}">{{ row.label }}</td>
      <td style="padding:7px 8px 7px 0;border-bottom:1px solid #dde1e4;{{ 'font-weight:700;color:#1b2733;' if active else 'color:#374350;' }}">{{ row.kp }}</td>
      <td style="padding:7px 0;border-bottom:1px solid #dde1e4;color:#5b6773;">{{ row.effect }}</td>
    </tr>
    {% endfor %}
  </table>
</td></tr>

{% if aurora.show %}
<tr><td style="padding:26px 30px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border:1px solid #1b2733;">
    <tr><td style="padding:10px 14px;font-family:{{ sans }};font-size:12px;font-weight:700;color:#1b2733;border-bottom:1px solid #c7cdd3;">Aurora watch</td></tr>
    <tr><td style="padding:12px 14px 0;">
      <img src="cid:aurora_vid" width="510" alt="Kp-dependent auroral intensity prediction" style="width:100%;max-width:510px;height:auto;display:block;border:1px solid #c7cdd3;">
    </td></tr>
    <tr><td style="padding:10px 14px 14px;font-family:{{ sans }};font-size:13px;color:#374350;line-height:1.5;">{{ aurora.note }}</td></tr>
  </table>
</td></tr>
{% endif %}

<tr><td style="padding:30px 30px 26px;">
  <div style="border-top:1px solid #c7cdd3;padding-top:12px;font-family:{{ sans }};font-size:10px;color:#5b6773;line-height:1.6;">
    This is an automated bulletin from the Kp Index Monitoring System using the GFZ Space Weather Forecast.<br><br>
    &copy; {{ year }} GFZ Helmholtz Centre for Geosciences | GFZ Helmholtz-Zentrum f&uuml;r Geoforschung.
    The data/data products are provided "as-is" without warranty of any kind, either expressed or implied, including but not limited to the implied warranties of merchantability, correctness and fitness for a particular purpose. GFZ is not liable for any direct, indirect, incidental or consequential damages arising from the use of this data.
  </div>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
