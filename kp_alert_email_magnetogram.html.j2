{#
  Design option: "Magnetogram"
  Modelled on the analog magnetometer strip-chart paper that Kp was
  historically read from by eye: sepia instrument paper, a hand-traced
  threshold line, typewritten annotations.
  Same context contract as kp_alert_email.html.j2. See that file's header
  for the full field list.
#}
{% set severity_color = {'G1': '#9c5a1f', 'G2': '#a8461f', 'G3': '#a8461f', 'G4': '#8a2a1f', 'G5': '#7a1414'} %}
{% set ink_accent = severity_color[level_code] %}
{% set activity_rows = [
  {'code':'QUIET','label':'Quiet','kp':'0–3','effect':'Quiet conditions'},
  {'code':'ACTIVE','label':'Active','kp':'4','effect':'Moderate geomagnetic activity'},
  {'code':'G1','label':'Minor Storm (G1)','kp':'5','effect':'Weak power grid fluctuations'},
  {'code':'G2','label':'Moderate Storm (G2)','kp':'6','effect':'High-latitude power systems affected'},
  {'code':'G3','label':'Strong Storm (G3)','kp':'7','effect':'Power systems may need voltage corrections'},
  {'code':'G4','label':'Severe Storm (G4)','kp':'8','effect':'Possible widespread voltage control problems'},
  {'code':'G5','label':'Extreme Storm (G5)','kp':'9','effect':'Widespread power system voltage control problems'},
] %}
{% set caption = forecast_caption if forecast_caption is defined and forecast_caption else "Colours indicate geomagnetic activity levels: green for quiet (Kp < 3), yellow for moderate (3 < Kp <= 6), red for storm (Kp > 6). The dashed line is the official NOAA SWPC Kp forecast; error bars show the ensemble min-max spread." %}
{% set mono = "'Courier New', Courier, monospace" %}
{% set serif = "Palatino, 'Palatino Linotype', 'Book Antiqua', Georgia, serif" %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#d9cba4;">
<span style="display:none;font-size:1px;color:#ecdfc0;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">{{ subject }}</span>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#ecdfc0;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#f2e9d8;border:1px solid #cdbb8c;">

<tr><td style="padding:18px 28px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
    <td style="font-family:{{ mono }};font-size:11px;letter-spacing:0.04em;color:#6b5230;">GFZ MAGNETIC OBSERVATORY &mdash; KP LOG</td>
    <td align="right" style="font-family:{{ mono }};font-size:11px;color:#6b5230;">{{ issued }}</td>
  </tr></table>
  <div style="border-top:1px solid #cdbb8c;margin-top:8px;background-image:repeating-linear-gradient(90deg, #cdbb8c 0, #cdbb8c 1px, transparent 1px, transparent 12px);height:1px;"></div>
</td></tr>

<tr><td style="padding:16px 28px 0;">
  <table role="presentation" cellpadding="0" cellspacing="0"><tr><td>
    <div style="display:inline-block;transform:rotate(-3deg);border:2px solid {{ ink_accent }};color:{{ ink_accent }};font-family:{{ mono }};font-size:13px;font-weight:700;letter-spacing:0.08em;padding:5px 12px;">{{ level_code }} &middot; {{ level_name | upper }}</div>
  </td></tr></table>
</td></tr>

<tr><td style="padding:14px 28px 0;">
  <svg viewBox="0 0 540 90" width="540" height="90" style="width:100%;height:auto;display:block;" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Stylised magnetometer trace">
    <line x1="0" y1="18" x2="540" y2="18" stroke="#cdbb8c" stroke-width="1"/>
    <line x1="0" y1="45" x2="540" y2="45" stroke="#cdbb8c" stroke-width="1"/>
    <line x1="0" y1="72" x2="540" y2="72" stroke="{{ ink_accent }}" stroke-width="1" stroke-dasharray="4 3"/>
    <path d="M0,50 C 30,46 45,20 70,22 S 110,55 140,50 170,15 200,12 240,60 270,66 310,25 340,20 380,58 410,62 450,18 480,15 510,40 540,35"
          fill="none" stroke="#3b2a1a" stroke-width="1.6"/>
  </svg>
  <div style="font-family:{{ mono }};font-size:9px;color:#6b5230;letter-spacing:0.03em;">TRACE (illustrative) &mdash; dashed line: {{ level_code }} threshold</div>
</td></tr>

<tr><td style="padding:20px 28px 0;font-family:{{ serif }};font-size:21px;color:#3b2a1a;line-height:1.35;">
  {{ headline }}
</td></tr>
<tr><td style="padding:10px 28px 0;font-family:{{ serif }};font-size:14px;font-style:italic;color:#4a3a24;line-height:1.6;">
  {{ lede }}
</td></tr>

<tr><td style="padding:16px 28px 0;font-family:{{ mono }};font-size:11px;color:#6b5230;line-height:1.7;">
  OBS.......{{ current_conditions }}<br>
  LOGGED....{{ issued }}
</td></tr>

<tr><td style="padding:18px 28px 0;">
  <img src="cid:forecast_image" width="536" alt="Kp forecast ensemble chart" style="width:100%;max-width:536px;height:auto;display:block;border:1px solid #cdbb8c;filter:sepia(20%);">
</td></tr>
<tr><td style="padding:8px 28px 0;font-family:{{ serif }};font-style:italic;font-size:12px;color:#6b5230;line-height:1.5;">
  {{ caption }}
</td></tr>

<tr><td style="padding:26px 28px 0;">
  <div style="font-family:{{ mono }};font-size:11px;letter-spacing:0.06em;color:#3b2a1a;border-bottom:1px dashed #cdbb8c;padding-bottom:6px;">STORM PROBABILITY LOG &mdash; KP &ge; 6</div>
{% if storm_rows %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ mono }};font-size:12px;margin:8px 0 0;">
  <tr>
    <td style="padding:4px 6px 4px 0;color:#6b5230;">TIME (UTC)</td>
    <td style="padding:4px 6px 4px 0;color:#6b5230;">6-7</td>
    <td style="padding:4px 6px 4px 0;color:#6b5230;">7-8</td>
    <td style="padding:4px 0;color:#6b5230;">&ge;8</td>
  </tr>
  {% for row in storm_rows %}
    <tr>
      <td style="padding:4px 6px 4px 0;border-top:1px dashed #cdbb8c;color:#3b2a1a;">{{ row.time }}</td>
      <td style="padding:4px 6px 4px 0;border-top:1px dashed #cdbb8c;color:#3b2a1a;">{{ row.p67 }}</td>
      <td style="padding:4px 6px 4px 0;border-top:1px dashed #cdbb8c;color:#3b2a1a;">{{ row.p78 }}</td>
      <td style="padding:4px 0;border-top:1px dashed #cdbb8c;color:#3b2a1a;">{{ row.p8 }}</td>
    </tr>
  {% endfor %}
  </table>
  <div style="font-family:{{ mono }};font-size:10px;color:#6b5230;padding-top:6px;">entries where combined P(Kp&ge;6) &gt; 50%</div>
{% else %}
  <div style="font-family:{{ mono }};font-size:12px;color:#6b5230;padding:10px 0 0;">no tier exceeds 50% probability</div>
{% endif %}
</td></tr>

<tr><td style="padding:26px 28px 0;">
  <div style="font-family:{{ mono }};font-size:11px;letter-spacing:0.06em;color:#3b2a1a;border-bottom:1px dashed #cdbb8c;padding-bottom:6px;">GEOMAGNETIC ACTIVITY SCALE</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ serif }};font-size:13px;margin:8px 0 0;">
    {% for row in activity_rows %}
    {% set active = row.code == activity_current_code %}
    <tr>
      <td style="padding:6px 8px 6px 0;border-bottom:1px dashed #cdbb8c;{{ 'font-weight:700;color:' ~ ink_accent ~ ';' if active else 'color:#4a3a24;' }}">{{ '&#10003; ' | safe if active else '&nbsp;&nbsp;&nbsp;' | safe }}{{ row.label }}</td>
      <td style="padding:6px 8px 6px 0;border-bottom:1px dashed #cdbb8c;font-family:{{ mono }};color:#6b5230;">{{ row.kp }}</td>
      <td style="padding:6px 0;border-bottom:1px dashed #cdbb8c;color:#6b5230;">{{ row.effect }}</td>
    </tr>
    {% endfor %}
  </table>
</td></tr>

{% if aurora.show %}
<tr><td style="padding:26px 28px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border:1px dashed {{ ink_accent }};">
    <tr><td style="padding:10px 14px;font-family:{{ mono }};font-size:12px;letter-spacing:0.06em;color:{{ ink_accent }};">AURORA WATCH &mdash; NOTED IN LOG</td></tr>
    <tr><td style="padding:0 14px 10px;">
      <img src="cid:aurora_vid" width="506" alt="Kp-dependent auroral intensity prediction" style="width:100%;max-width:506px;height:auto;display:block;border:1px solid #cdbb8c;filter:sepia(20%);">
    </td></tr>
    <tr><td style="padding:0 14px 12px;font-family:{{ serif }};font-size:13px;color:#4a3a24;line-height:1.5;">{{ aurora.note }}</td></tr>
  </table>
</td></tr>
{% endif %}

<tr><td style="padding:28px 28px 24px;">
  <div style="border-top:1px solid #cdbb8c;padding-top:12px;font-family:{{ mono }};font-size:10px;color:#6b5230;line-height:1.6;">
    AUTOMATED ENTRY &mdash; KP INDEX MONITORING SYSTEM &mdash; GFZ SPACE WEATHER FORECAST<br><br>
    &copy; {{ year }} GFZ Helmholtz Centre for Geosciences. Data provided "as-is" without warranty of any kind. GFZ is not liable for damages arising from use of this data.
  </div>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
