{#
  Design option: "Aurora Signal"
  Atmospheric treatment aimed at the aurora-watching audience: a polar-sky
  gradient hero, and the activity scale rendered as a spectrum bar with a
  position marker instead of a plain table.
  Same context contract as kp_alert_email.html.j2. See that file's header
  for the full field list.
#}
{% set spectrum = ['QUIET','ACTIVE','G1','G2','G3','G4','G5'] %}
{% set spectrum_color = {
  'QUIET': '#2ecc8f', 'ACTIVE': '#4fd6c9', 'G1': '#6dc7f0', 'G2': '#9b6bff',
  'G3': '#c86bff', 'G4': '#ff6fa5', 'G5': '#ff2f6e',
} %}
{% set marker_pct = (spectrum.index(activity_current_code) / (spectrum | length - 1) * 100) if activity_current_code in spectrum else 0 %}
{% set marker_color = spectrum_color.get(activity_current_code, '#2ecc8f') %}
{% set activity_rows = [
  {'code':'QUIET','label':'Quiet','kp':'0–3','effect':'Quiet conditions'},
  {'code':'ACTIVE','label':'Active','kp':'4','effect':'Moderate geomagnetic activity'},
  {'code':'G1','label':'Minor Storm (G1)','kp':'5','effect':'Weak power grid fluctuations'},
  {'code':'G2','label':'Moderate Storm (G2)','kp':'6','effect':'High-latitude power systems affected'},
  {'code':'G3','label':'Strong Storm (G3)','kp':'7','effect':'Power systems may need voltage corrections'},
  {'code':'G4','label':'Severe Storm (G4)','kp':'8','effect':'Possible widespread voltage control problems'},
  {'code':'G5','label':'Extreme Storm (G5)','kp':'9','effect':'Widespread power system voltage control problems'},
] %}
{% set caption = forecast_caption if forecast_caption is defined and forecast_caption else "Colours indicate geomagnetic activity levels: green for quiet (Kp < 3), yellow for moderate (3 < Kp <= 6), red for storm (Kp > 6). The dashed line is the official NOAA SWPC Kp forecast; error bars show the ensemble min-max spread." %}
{% set display = "'Century Gothic', Futura, 'Trebuchet MS', sans-serif" %}
{% set body = "Avenir, 'Segoe UI', Helvetica, Arial, sans-serif" %}
{% set mono = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#e7ebee;">
<span style="display:none;font-size:1px;color:#fbfcfc;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">{{ subject }}</span>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#e7ebee;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#fbfcfc;">

<tr><td style="background-color:#0d3b3a;background-image:linear-gradient(160deg,#071b2e 0%,#0d3b3a 55%,#123a2e 100%);padding:28px 30px 34px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
    <td style="font-family:{{ body }};font-size:12px;letter-spacing:0.03em;color:#bfe9df;">GFZ Space Weather</td>
    <td align="right" style="font-family:{{ body }};font-size:12px;color:#8fb8ae;">{{ issued }}</td>
  </tr></table>
  <div style="font-family:{{ display }};font-size:30px;font-weight:700;color:#f4fbf9;line-height:1.25;padding-top:18px;">{{ headline }}</div>
</td></tr>

<tr><td style="padding:22px 30px 0;font-family:{{ body }};font-size:15px;color:#33413f;line-height:1.6;">
  {{ lede }}
</td></tr>

<tr><td style="padding:14px 30px 0;font-family:{{ mono }};font-size:12px;color:#5f7370;">
  CURRENT: {{ current_conditions }}
</td></tr>

<tr><td style="padding:18px 30px 0;">
  <img src="cid:forecast_image" width="540" alt="Kp forecast ensemble chart" style="width:100%;max-width:540px;height:auto;display:block;border-radius:6px;">
</td></tr>
<tr><td style="padding:8px 30px 0;font-family:{{ body }};font-style:italic;font-size:12px;color:#6b7876;line-height:1.5;">
  {{ caption }}
</td></tr>

<tr><td style="padding:26px 30px 0;">
  <div style="font-family:{{ display }};font-size:15px;font-weight:700;color:#123a2e;">Storm probability &middot; Kp &ge; 6</div>
{% if storm_rows %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ body }};font-size:13px;margin:10px 0 0;">
  <tr>
    <td style="padding:6px 8px 6px 0;border-bottom:2px solid #123a2e;font-size:11px;color:#6b7876;">Time (UTC)</td>
    <td style="padding:6px 8px 6px 0;border-bottom:2px solid #123a2e;font-size:11px;color:#6b7876;">Kp 6&ndash;7</td>
    <td style="padding:6px 8px 6px 0;border-bottom:2px solid #123a2e;font-size:11px;color:#6b7876;">Kp 7&ndash;8</td>
    <td style="padding:6px 0;border-bottom:2px solid #123a2e;font-size:11px;color:#6b7876;">Kp &ge; 8</td>
  </tr>
  {% for row in storm_rows %}
    <tr>
      <td style="padding:7px 8px 7px 0;border-bottom:1px solid #e2e8e7;color:#33413f;">{{ row.time }}</td>
      <td style="padding:7px 8px 7px 0;border-bottom:1px solid #e2e8e7;color:#33413f;">{{ row.p67 }}</td>
      <td style="padding:7px 8px 7px 0;border-bottom:1px solid #e2e8e7;color:#33413f;">{{ row.p78 }}</td>
      <td style="padding:7px 0;border-bottom:1px solid #e2e8e7;color:#33413f;">{{ row.p8 }}</td>
    </tr>
  {% endfor %}
  </table>
  <div style="font-family:{{ body }};font-style:italic;font-size:11px;color:#6b7876;padding-top:6px;">Showing timestamps where combined probability of Kp &ge; 6 exceeds 50%.</div>
{% else %}
  <div style="font-family:{{ body }};font-style:italic;font-size:12px;color:#6b7876;margin:10px 0 0;">No individual storm-tier probability exceeds 50% at this time.</div>
{% endif %}
</td></tr>

<tr><td style="padding:30px 30px 0;">
  <div style="font-family:{{ display }};font-size:15px;font-weight:700;color:#123a2e;padding-bottom:14px;">Geomagnetic activity spectrum</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;">
    <tr><td style="height:10px;border-radius:5px;background-image:linear-gradient(to right, #2ecc8f, #4fd6c9, #6dc7f0, #9b6bff, #c86bff, #ff6fa5, #ff2f6e);font-size:0;line-height:0;">&nbsp;</td></tr>
  </table>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
    <td align="{{ 'left' if marker_pct < 15 else ('right' if marker_pct > 85 else 'center') }}" style="padding-top:6px;">
      <table role="presentation" cellpadding="0" cellspacing="0" style="margin-left:{{ marker_pct }}%;transform:translateX(-50%);"><tr>
        <td style="font-family:{{ mono }};font-size:11px;font-weight:700;color:{{ marker_color }};white-space:nowrap;">&#9650; {{ activity_current_code }}</td>
      </tr></table>
    </td>
  </tr></table>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ body }};font-size:12px;margin:14px 0 0;">
    {% for row in activity_rows %}
    {% set active = row.code == activity_current_code %}
    <tr>
      <td width="10" style="padding:5px 0;"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:{{ spectrum_color[row.code] }};"></span></td>
      <td style="padding:5px 8px;{{ 'font-weight:700;color:#123a2e;' if active else 'color:#4a5654;' }}">{{ row.label }}</td>
      <td style="padding:5px 8px;{{ 'font-weight:700;color:#123a2e;' if active else 'color:#4a5654;' }}">Kp {{ row.kp }}</td>
      <td style="padding:5px 0;color:#6b7876;">{{ row.effect }}</td>
    </tr>
    {% endfor %}
  </table>
</td></tr>

{% if aurora.show %}
<tr><td style="padding:30px 30px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background-image:linear-gradient(135deg,#0d3b3a,#123a2e);border-radius:10px;">
    <tr><td style="padding:16px 18px 6px;font-family:{{ display }};font-size:15px;font-weight:700;color:#c86bff;">Aurora watch</td></tr>
    <tr><td style="padding:8px 18px 0;">
      <img src="cid:aurora_vid" width="504" alt="Kp-dependent auroral intensity prediction" style="width:100%;max-width:504px;height:auto;display:block;border-radius:6px;">
    </td></tr>
    <tr><td style="padding:12px 18px 18px;font-family:{{ body }};font-size:13px;color:#dff2ec;line-height:1.5;">{{ aurora.note }}</td></tr>
  </table>
</td></tr>
{% endif %}

<tr><td style="padding:32px 30px 26px;">
  <div style="border-top:1px solid #dde4e2;padding-top:12px;font-family:{{ body }};font-size:11px;color:#6b7876;line-height:1.6;">
    This is an automated alert from the Kp Index Monitoring System using the GFZ Space Weather Forecast.<br><br>
    &copy; {{ year }} GFZ Helmholtz Centre for Geosciences | GFZ Helmholtz-Zentrum f&uuml;r Geoforschung.
    The data/data products are provided "as-is" without warranty of any kind, either expressed or implied, including but not limited to the implied warranties of merchantability, correctness and fitness for a particular purpose. GFZ is not liable for any direct, indirect, incidental or consequential damages arising from the use of this data.
  </div>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
