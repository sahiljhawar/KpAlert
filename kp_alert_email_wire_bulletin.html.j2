{#
  Design option: "Wire Bulletin"
  Modelled directly on real NOAA/SWPC space-weather wire advisories:
  colon-prefixed header fields, fixed-width body, tractor-feed edges.
  The all-caps/monospace voice here is authentic to that real format,
  not a decorative default.
  Same context contract as kp_alert_email.html.j2. See that file's header
  for the full field list.
#}
{% set severity_color = {'G1': '#4f7ea8', 'G2': '#b98a2e', 'G3': '#c1602b', 'G4': '#a63232', 'G5': '#8a1030'} %}
{% set strip_color = severity_color[level_code] %}
{% set activity_rows = [
  {'code':'QUIET','label':'QUIET','kp':'0-3','effect':'Quiet conditions'},
  {'code':'ACTIVE','label':'ACTIVE','kp':'4','effect':'Moderate geomagnetic activity'},
  {'code':'G1','label':'MINOR STORM (G1)','kp':'5','effect':'Weak power grid fluctuations'},
  {'code':'G2','label':'MODERATE STORM (G2)','kp':'6','effect':'High-latitude power systems affected'},
  {'code':'G3','label':'STRONG STORM (G3)','kp':'7','effect':'Power systems may need voltage corrections'},
  {'code':'G4','label':'SEVERE STORM (G4)','kp':'8','effect':'Possible widespread voltage control problems'},
  {'code':'G5','label':'EXTREME STORM (G5)','kp':'9','effect':'Widespread power system voltage control problems'},
] %}
{% set caption = forecast_caption if forecast_caption is defined and forecast_caption else "Colours indicate geomagnetic activity levels: green for quiet (Kp < 3), yellow for moderate (3 < Kp <= 6), red for storm (Kp > 6). The dashed line is the official NOAA SWPC Kp forecast; error bars show the ensemble min-max spread." %}
{% set mono = "'Courier New', Courier, ui-monospace, monospace" %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#e4e4de;">
<span style="display:none;font-size:1px;color:#fafaf7;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">{{ subject }}</span>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#fafaf7;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:560px;max-width:560px;background:#fffffd;border-left:1px solid #d6d6cd;border-right:1px solid #d6d6cd;">

<tr><td style="background-image:repeating-linear-gradient(90deg, #d6d6cd 0, #d6d6cd 6px, transparent 6px, transparent 14px);height:6px;font-size:0;line-height:0;">&nbsp;</td></tr>

<tr><td style="padding:20px 26px 0;font-family:{{ mono }};font-size:12px;color:#17181a;line-height:1.8;">
:PRODUCT: SPACE WEATHER ALERT<br>
:ISSUED: {{ issued | upper }}<br>
:SOURCE: GFZ HELMHOLTZ CENTRE FOR GEOSCIENCES<br>
:LEVEL: {{ level_code }} &mdash; {{ level_name | upper }}
</td></tr>

<tr><td style="padding:14px 26px 0;">
  <div style="height:4px;background:{{ strip_color }};"></div>
</td></tr>

<tr><td style="padding:16px 26px 0;font-family:{{ mono }};font-size:13px;font-weight:700;color:#17181a;line-height:1.6;">
{{ headline | upper }}
</td></tr>

<tr><td style="padding:12px 26px 0;font-family:{{ mono }};font-size:12px;color:#3a3b3d;line-height:1.7;">
{{ lede }}
</td></tr>

<tr><td style="padding:16px 26px 0;font-family:{{ mono }};font-size:11px;color:#5a5c5f;line-height:1.8;border-top:1px solid #e6e6e0;border-bottom:1px solid #e6e6e0;padding-top:10px;padding-bottom:10px;">
CURRENT COND..... {{ current_conditions | upper }}<br>
ALERT SENT....... {{ issued | upper }}
</td></tr>

<tr><td style="padding:18px 26px 0;">
  <img src="cid:forecast_image" width="504" alt="Kp forecast ensemble chart" style="width:100%;max-width:504px;height:auto;display:block;border:1px solid #d6d6cd;">
</td></tr>
<tr><td style="padding:8px 26px 0;font-family:{{ mono }};font-size:10px;color:#5a5c5f;line-height:1.6;">
NOTE: {{ caption | upper }}
</td></tr>

<tr><td style="padding:22px 26px 0;font-family:{{ mono }};font-size:11px;color:#17181a;letter-spacing:0.03em;">
STORM PROBABILITY FCST (KP &ge; 6)
</td></tr>
{% if storm_rows %}
<tr><td style="padding:6px 26px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ mono }};font-size:11px;">
  <tr>
    <td style="padding:3px 4px 3px 0;border-bottom:1px solid #17181a;color:#17181a;">TIME UTC</td>
    <td style="padding:3px 4px 3px 0;border-bottom:1px solid #17181a;color:#17181a;">6-7</td>
    <td style="padding:3px 4px 3px 0;border-bottom:1px solid #17181a;color:#17181a;">7-8</td>
    <td style="padding:3px 0;border-bottom:1px solid #17181a;color:#17181a;">&ge;8</td>
  </tr>
  {% for row in storm_rows %}
    <tr>
      <td style="padding:3px 4px 3px 0;color:#3a3b3d;">{{ row.time }}</td>
      <td style="padding:3px 4px 3px 0;color:#3a3b3d;">{{ row.p67 }}</td>
      <td style="padding:3px 4px 3px 0;color:#3a3b3d;">{{ row.p78 }}</td>
      <td style="padding:3px 0;color:#3a3b3d;">{{ row.p8 }}</td>
    </tr>
  {% endfor %}
  </table>
</td></tr>
{% else %}
<tr><td style="padding:6px 26px 0;font-family:{{ mono }};font-size:11px;color:#5a5c5f;">NO TIER EXCEEDS 50 PCT PROBABILITY</td></tr>
{% endif %}

<tr><td style="padding:22px 26px 0;font-family:{{ mono }};font-size:11px;color:#17181a;letter-spacing:0.03em;">
GEOMAGNETIC ACTIVITY SCALE
</td></tr>
<tr><td style="padding:6px 26px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:{{ mono }};font-size:11px;">
    {% for row in activity_rows %}
    {% set active = row.code == activity_current_code %}
    <tr>
      <td style="padding:3px 4px 3px 0;{{ 'font-weight:700;color:' ~ severity_color.get(row.code, '#17181a') ~ ';' if active else 'color:#3a3b3d;' }}">{{ '>' if active else ' ' }} {{ row.label }}</td>
      <td style="padding:3px 4px 3px 0;color:#5a5c5f;">KP {{ row.kp }}</td>
      <td style="padding:3px 0;color:#5a5c5f;">{{ row.effect | upper }}</td>
    </tr>
    {% endfor %}
  </table>
</td></tr>

{% if aurora.show %}
<tr><td style="padding:22px 26px 0;font-family:{{ mono }};font-size:11px;color:{{ strip_color }};letter-spacing:0.03em;border-top:1px solid #e6e6e0;padding-top:16px;">
&#9642; AURORA WATCH
</td></tr>
<tr><td style="padding:8px 26px 0;">
  <img src="cid:aurora_vid" width="504" alt="Kp-dependent auroral intensity prediction" style="width:100%;max-width:504px;height:auto;display:block;border:1px solid #d6d6cd;">
</td></tr>
<tr><td style="padding:8px 26px 0;font-family:{{ mono }};font-size:11px;color:#3a3b3d;line-height:1.6;">
{{ aurora.note | upper }}
</td></tr>
{% endif %}

<tr><td style="padding:24px 26px 0;font-family:{{ mono }};font-size:10px;color:#5a5c5f;line-height:1.7;border-top:1px solid #e6e6e0;margin-top:10px;">
AUTOMATED PRODUCT OF THE KP INDEX MONITORING SYSTEM.<br>
GFZ SPACE WEATHER FORECAST. (C) {{ year }} GFZ HELMHOLTZ CENTRE FOR GEOSCIENCES.<br>
DATA PROVIDED "AS-IS" WITHOUT WARRANTY. GFZ NOT LIABLE FOR DAMAGES ARISING FROM USE OF THIS DATA.
</td></tr>
<tr><td style="height:20px;font-size:0;line-height:0;">&nbsp;</td></tr>
<tr><td style="background-image:repeating-linear-gradient(90deg, #d6d6cd 0, #d6d6cd 6px, transparent 6px, transparent 14px);height:6px;font-size:0;line-height:0;">&nbsp;</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
